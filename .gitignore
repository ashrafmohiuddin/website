# OS junk
.DS_Store
**/.DS_Store
Thumbs.db

# Edited Lightroom exports — keep the folder + metadata, ignore dropped files
photos-drop/*
!photos-drop/.gitkeep
!photos-drop/metadata.json

# Legacy inbox name (do not use)
photos-inbox/*

# Pipeline outputs: full-res originals (local fallback / R2 source)
images/*.jpg
images/*.jpeg
images/*.png
images/*.JPG
images/*.JPEG
images/*.PNG
images/*.webp
images/*.WEBP

# Watermarked full-res downloads — serve from R2 (img.sashraf.in)
images/watermarked/*
!images/watermarked/.gitkeep

# Keep in git (do not ignore):
#   images/low-res/     gallery previews (commit after processing)
#   data/photos.manifest.json
#   photos-drop/metadata.json
#   images/other/       non-gallery assets
